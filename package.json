{
  "name": "desafio-jungle-gaming",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Processador de transações financeiras distribuído para plataforma de iGaming — desafio técnico Jungle Gaming.",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "bun test --path-ignore-patterns '**/*.integration.test.ts'",
    "test:integration": "bun test integration",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1119.0",
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/migrations": "^7.1.14",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.1.14",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jose": "^6.2.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@mikro-orm/cli": "^7.1.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "bun-types": "^1.1.34",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0"
  }
}
